[Unit]
Description=Headless Bluetooth auto-accept agent
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/benkalmus/repos/audio-setup-cm6206/bin/bluetooth-auto-agent
Restart=always
RestartSec=3
StartLimitIntervalSec=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
